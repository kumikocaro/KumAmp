<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>KumAmp @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="12.0"/></allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="vst3" title="Plugin VST3" description="Para REAPER, Ableton Live, Cubase, Studio One, Bitwig... Se instala en /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.kumampaudio.kumamp.vst3"/>
    </choice>
    <choice id="au" title="Plugin Audio Unit (AU)" description="Para Logic Pro y GarageBand. Se instala en /Library/Audio/Plug-Ins/Components.">
        <pkg-ref id="com.kumampaudio.kumamp.au"/>
    </choice>
    <choice id="app" title="Aplicacion KumAmp" description="Version independiente, sin DAW: usa la entrada de tu interfaz de audio. Se instala en Aplicaciones.">
        <pkg-ref id="com.kumampaudio.kumamp.app"/>
    </choice>

    <pkg-ref id="com.kumampaudio.kumamp.vst3" version="@VERSION@" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.kumampaudio.kumamp.au" version="@VERSION@" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.kumampaudio.kumamp.app" version="@VERSION@" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
